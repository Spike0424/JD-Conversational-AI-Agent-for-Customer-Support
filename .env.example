OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.2
MAX_HISTORY_TURNS=6
DOCS_ROOT=.
# DeepSeek: use disabled for ReAct/tool agents (avoids reasoning_content 400). Values: auto | enabled | disabled
CHAT_THINKING_MODE=auto
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./agent_sessions.db
RAG_ENABLED=true
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
ENABLE_BUSINESS_TOOLS=true
ENABLE_DEV_TOOLS=false
