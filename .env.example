OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
# RAG 需要单独配置支持 OpenAI 风格 /v1/embeddings 的服务（DeepSeek 无此接口）
# EMBEDDING_OPENAI_API_KEY=
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 聚合网关大批次易触发 500，可调小批量或关闭重试
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_MAX_RETRIES=1
MODEL_NAME=deepseek-v4-flash
chat_thinking_mode=disabled
EMBEDDING_PROVIDER=local
TEMPERATURE=0.2
MAX_HISTORY_TURNS=6
DOCS_ROOT=.
# DeepSeek: use disabled for ReAct/tool agents (avoids reasoning_content 400). Values: auto | enabled | disabled
CHAT_THINKING_MODE=disabled
CHAT_TIMEOUT_SECONDS=60
CHAT_RETRIES=1
AGENT_RECURSION_LIMIT=20
REDIS_URL=
DATABASE_URL=
RAG_ENABLED=true
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=80
RAG_INDEX_DIR=.rag/faiss
RAG_SCORE_THRESHOLD=-1
RAG_DEDUPLICATE_RESULTS=true
ENABLE_BUSINESS_TOOLS=true
ENABLE_DEV_TOOLS=false
BUSINESS_API_TIMEOUT_SECONDS=30
BUSINESS_API_RETRIES=2
BUSINESS_API_KEY=
OMS_BASE_URL=
CRM_BASE_URL=
AFTERSALE_BASE_URL=
APP_ENV=development
FASTEMBED_CACHE_DIR=
# LOG_ROTATION_MB=10
# LOG_RETENTION_DAYS=7
